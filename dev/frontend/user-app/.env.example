# 다섯 개를 손으로 찾지 말고 뽑아 옵니다.
#   cd ../../backend/terraform && terraform output -json user_app_env
#
# NEXT_PUBLIC_ 값은 빌드할 때 화면 코드에 그대로 박힙니다. 브라우저가 읽을 수 있으므로
# 비밀을 넣지 않습니다. 사용자 앱의 앱 클라이언트는 비밀이 없는 공개 클라이언트라
# (cognito.tf 의 generate_secret = false) 넣을 비밀 자체가 없습니다.

# API Gateway 주소. terraform apply 출력의 api_base_url 과 같습니다.
NEXT_PUBLIC_API_BASE_URL=

# 사용자 앱 몫의 앱 클라이언트 ID. 관리자 콘솔 것과 다릅니다.
NEXT_PUBLIC_COGNITO_CLIENT=

# 사내 공용 값. 프로젝트마다 같습니다.
NEXT_PUBLIC_COGNITO_DOMAIN=https://openiot-guardrails-prod.auth.ap-northeast-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-2
NEXT_PUBLIC_COGNITO_POOL_ID=ap-northeast-2_pjubwRozp
