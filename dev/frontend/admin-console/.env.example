# 다섯이 다 있어야 로그인이 켜집니다. 반쯤 설정하면 콜백에서 실패해 아무도 못 들어옵니다.

# 프로젝트마다 새로 받는 값 (AWS 콘솔에서 공용 풀 ap-northeast-2_pjubwRozp 아래 앱 클라이언트 생성)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# 백엔드 주소. terraform output -raw api_base_url 결과입니다.
# 비우면 로그인은 되고 API 호출만 막힙니다.
# 이름을 바꾸거나 다른 서버 환경변수를 더하면 amplify.yml 의 추리기 목록에도 넣어야 합니다.
API_BASE_URL=

# 사내 공용 값. 프로젝트마다 같습니다. 바꾸지 않습니다.
COGNITO_DOMAIN=openiot-guardrails-prod.auth.ap-northeast-2.amazoncognito.com
COGNITO_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_pjubwRozp

# openssl rand -base64 48
# 이 값을 바꾸면 나가 있는 세션 쿠키가 전부 한 번에 죽습니다 (즉시 차단 절차).
SESSION_SECRET=

# 선택. 세션 수명이 곧 퇴사자 실제 차단 창입니다. 기본 8시간.
# SESSION_TTL_SECONDS=28800
